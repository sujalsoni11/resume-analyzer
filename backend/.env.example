# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Get a free cluster at https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resume-analyzer?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters — use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# Free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: your Vercel frontend URL e.g. https://resume-ai.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── File Upload ──────────────────────────────────────────────────────────────
# Max upload size in bytes (default 10MB)
MAX_FILE_SIZE=10485760
